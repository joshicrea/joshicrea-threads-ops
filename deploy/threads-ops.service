[Unit]
Description=Threads Ops Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threads
Group=threads
WorkingDirectory=/opt/threads-ops
EnvironmentFile=/etc/threads-ops.env
Environment=HOME=/home/threads
ExecStart=/usr/bin/node /opt/threads-ops/start.js
Restart=always
RestartSec=5
# 書けるのはデータ置き場（db.json・バックアップ・claude-config）と threads のホーム（Claude Code 本体の更新先）だけ。/opt/threads-ops は読み取り専用
ReadWritePaths=/var/lib/threads-ops /home/threads
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
