# Threads運用アシスタント（サーバー運用）の環境変数。/etc/threads-ops.env に置く（所有者 root・権限 600）
# 公開URL（Caddy が https で受ける。末尾スラッシュ無し）
THREADS_PUBLIC_ORIGIN=https://threads.example.com
# 画面のアクセスキー（8〜128文字）。初回起動時に設定へ入る。以後は画面の設定が優先
THREADS_ACCESS_KEY=change-me-to-a-long-random-string
# Claude Code の長期トークン。手元の PC で `claude setup-token` を実行して出た値を貼る（Claude の契約枠で動く・API 課金なし）
CLAUDE_CODE_OAUTH_TOKEN=
# 待ち受け（Caddy からの転送だけを受けるので loopback のまま。外へ直接開かない）
HOST=127.0.0.1
PORT=4173
# localhost 用の自己署名 https は不要
THREADS_HTTPS=0
# データの置き場所（キー・トークン・投稿が入る）
THREADS_DATA_DIR=/var/lib/threads-ops
# ブラウザを開かない
THREADS_NO_BROWSER=1
